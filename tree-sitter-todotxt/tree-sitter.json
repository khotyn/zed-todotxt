{
  "grammars": [
    {
      "name": "todotxt",
      "camelcase": "TodoTxt",
      "scope": "source.todotxt",
      "path": ".",
      "file-types": [
        "todotxt",
        "todo.txt",
        "done.txt"
      ]
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "MIT",
    "description": "Tree-sitter grammar for todo.txt files.",
    "authors": [
      {
        "name": "khotyn"
      }
    ],
    "links": {
      "repository": "https://github.com/khotyn/tree-sitter-todotxt"
    }
  },
  "bindings": {
    "c": true,
    "node": true
  }
}
